# Copy to .env and edit. Everything is optional — these are the defaults
# (a stock XAMPP / local MySQL install).
DUKA_DB_HOST=127.0.0.1
DUKA_DB_PORT=3306
DUKA_DB_USER=root
DUKA_DB_PASSWORD=
DUKA_DB_NAME=duka_pos

# Where the till's web page is served.
DUKA_HOST=127.0.0.1
DUKA_PORT=8080
# Use 0.0.0.0 to let other tills on the shop network open it.

# Optional: let the assistant answer ANY question about the shop's data.
# Install the free Ollama program (https://ollama.com), run `ollama pull qwen2.5:3b`
# once, and leave Ollama running - it is found automatically. These are only
# needed to override the defaults.
# DUKA_OLLAMA_MODEL=qwen2.5:3b
# DUKA_OLLAMA_URL=http://127.0.0.1:11434
# DUKA_OLLAMA_TIMEOUT=90
# Set to 1 to also have the model smooth the wording of every built-in answer.
# DUKA_OLLAMA_POLISH=1
