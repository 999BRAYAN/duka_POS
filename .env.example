# Copy to .env and edit. Everything is optional — these are the defaults
# (a stock XAMPP / local MySQL install).
DUKA_DB_HOST=127.0.0.1
DUKA_DB_PORT=3306
DUKA_DB_USER=root
DUKA_DB_PASSWORD=
DUKA_DB_NAME=duka_pos

# Where the till's web page is served.
DUKA_HOST=127.0.0.1
DUKA_PORT=8080
# Use 0.0.0.0 to let other tills on the shop network open it.
